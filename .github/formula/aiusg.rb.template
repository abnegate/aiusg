# typed: false
# frozen_string_literal: true

class Aiusg < Formula
  desc "Usage limits and reset times across all your AI provider accounts"
  homepage "https://github.com/{{REPO_OWNER}}/aiusg"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/{{REPO_OWNER}}/aiusg/releases/download/{{TAG}}/aiusg-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA256_AARCH64_APPLE_DARWIN}}"
    end
    on_intel do
      url "https://github.com/{{REPO_OWNER}}/aiusg/releases/download/{{TAG}}/aiusg-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA256_X86_64_APPLE_DARWIN}}"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/{{REPO_OWNER}}/aiusg/releases/download/{{TAG}}/aiusg-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA256_X86_64_UNKNOWN_LINUX_GNU}}"
    end
    on_arm do
      url "https://github.com/{{REPO_OWNER}}/aiusg/releases/download/{{TAG}}/aiusg-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA256_AARCH64_UNKNOWN_LINUX_GNU}}"
    end
  end

  def install
    bin.install Dir["aiusg-*"].first => "aiusg"
  end

  test do
    assert_match "aiusg", shell_output("#{bin}/aiusg --help")
  end
end
